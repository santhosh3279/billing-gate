# Billing 2FA Access Gate — Production Environment Settings

# Host IP binding interface (default: 0.0.0.0 for all interfaces)
BIND_IP=0.0.0.0

# Listening port forwarded to the host (default: 3100)
PORT=3100

# Host path for persistent credentials (users.json and secret.key)
# Default is ./data inside the project directory, or you can point to /var/lib/billing-gate
DATA_DIR_PATH=./data
